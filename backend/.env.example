# Supabase (required — handles auth, user data, API key storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: AI provider keys (Gemini, Claude, Groq, OpenRouter) are now
# stored per-user in Supabase's user_api_keys table. Each user enters
# their own keys via the Keys panel in the sidebar. NOT in .env anymore.
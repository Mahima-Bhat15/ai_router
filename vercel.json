{
  "version": 2,
  "outputDirectory": "frontend",
  "routes": [
    { "src": "^/$",              "dest": "/tap.html" },
    { "src": "^/tap$",           "dest": "/tap.html" },
    { "src": "^/chat$",          "dest": "/index.html" },
    { "src": "^/static/images/(.*)$", "dest": "/images/$1" },
    { "src": "^/(.*)",           "dest": "/$1" }
  ]
}
